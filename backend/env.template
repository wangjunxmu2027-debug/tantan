# AI调研助手-探探 环境配置
# 复制此文件为 .env 并填写实际配置

# 应用配置
APP_NAME=AI调研助手-探探
DEBUG=true

# API服务配置
API_HOST=0.0.0.0
API_PORT=8000

# LLM API 配置 (请替换为您的中转API)
LLM_API_BASE_URL=https://your-api-base-url/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o

# ============================================
# 飞书多维表格配置
# ============================================

# 【推荐】飞书应用 API 配置（支持实时查询 + 本地缓存）
# 步骤1: 在飞书开放平台创建应用 https://open.feishu.cn/app
# 步骤2: 添加权限：bitable:record:read（读取多维表格记录）
# 步骤3: 填写以下配置
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret

# 多维表格配置
# BITABLE_APP_TOKEN: 从多维表格 URL 获取，如 https://xxx.feishu.cn/base/ABC123 中的 ABC123
# BITABLE_QUESTIONS_TABLE_ID: 问题表的 ID，在表格设置中查看
BITABLE_APP_TOKEN=your-bitable-app-token
BITABLE_QUESTIONS_TABLE_ID=your-questions-table-id
BITABLE_RECORDS_TABLE_ID=your-records-table-id

# Webhook 配置（用于保存访谈记录）
WEBHOOK_RECORDS_URL=https://xxx.feishu.cn/base/automation/webhook/event/xxx

# Redis配置 (可选，不配置则使用内存存储)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# CORS配置
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
